# Which model to use. Default: a local model through Ollama, no API key needed.
AAC_LLM_PROVIDER=ollama            # ollama | openai | gemini
AAC_LLM_MODEL=                     # empty = qwen3.5:9b / gpt-4o-mini / gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434

# Only for the hosted providers:
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Optional
# AAC_LLM_TIMEOUT_S=120
# AAC_LLM_RETRIES=2
# AAC_TRIAGE_WORKERS=4
# AAC_TRACE_PATH=runs/trace.jsonl
